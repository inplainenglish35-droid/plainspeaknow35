{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "Node16",

    "outDir": "dist",
    "rootDir": ".",

   "strict": false,
"esModuleInterop": true,
"allowJs": true,
"skipLibCheck": true,

    "forceConsistentCasingInFileNames": true
  },

  "include": ["**/*.ts", "**/*.js"],
  "exclude": ["node_modules", "dist"]
}